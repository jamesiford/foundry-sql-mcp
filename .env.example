# Non-secret local configuration. Copy to .env and keep .env untracked.
AZURE_ENV_NAME=foundry-sql-mcp-dev
AZURE_LOCATION=
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=

# Tenant-specific, non-secret Microsoft Entra administrator values for SQL MI.
AZURE_SQL_ADMIN_LOGIN=
AZURE_SQL_ADMIN_OBJECT_ID=
AZURE_SQL_ADMIN_PRINCIPAL_TYPE=User
AZURE_DEPLOYER_OBJECT_ID=

# Validate model availability and quota in AZURE_LOCATION before deployment.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
AZURE_AI_MODEL_NAME=gpt-5.4-mini
AZURE_AI_MODEL_VERSION=2026-03-17
AZURE_AI_MODEL_SKU=GlobalStandard
AZURE_AI_MODEL_CAPACITY=10
